LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

BUSINESS_MCP_URL=http://localhost:8101/mcp
RAG_MCP_URL=http://localhost:8102/mcp
RABBITMQ_URL=amqp://mro:mro@localhost:5672/
RUN_QUEUE=mro.agent.run
EVENT_EXCHANGE=mro.agent
EVENT_ROUTING_KEY=agent.event

# Team deployment: a dedicated AI role with access to the langgraph schema only.
# CHECKPOINT_DATABASE_URL=postgresql://mro_ai:password@localhost:5432/mro
# Blank uses a persistent local SQLite checkpoint in STATE_DIR for standalone development.
CHECKPOINT_DATABASE_URL=
STATE_DIR=.state

# Optional backend-owned delegation broker. Otherwise use per-request AMQP headers
# rag_token / business_token. Never place those tokens in the request JSON.
MCP_DELEGATION_URL=
MCP_DELEGATION_KEY=

RUN_TIMEOUT_SECONDS=240
MODEL_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=10
TOOL_RETRIES=1
MAX_TOOL_CALLS=8
MAX_REINVESTIGATION=2
PUBLISH_TIMEOUT_SECONDS=10
RECONNECT_SECONDS=3
