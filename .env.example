# Committed configuration template. Keep all credential values empty.
# OpenAI API. Set your key in LLM_API_KEY locally (blank falls back to OPENAI_API_KEY).
# Supported models: gpt-4o-mini, gpt-4.1-mini, gpt-5.4-mini (app/main.py SUPPORTED_MODELS).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=

# MCP servers from the agent repo (Docker compose overrides these with service names).
BUSINESS_MCP_URL=http://localhost:8101/mcp
RAG_MCP_URL=http://localhost:8102/mcp

# Team interface v0.3 defaults for MCP tool calls.
TOOL_TIMEOUT_SECONDS=10
TOOL_RETRIES=1
MODEL_TIMEOUT_SECONDS=45
MAX_TOOL_CALLS=8
MAX_REINVESTIGATION=2

# FastAPI lifecycle/health; Spring still uses RabbitMQ.
# AI_MODE=rabbit consumes run requests. Backend attaches per-run MCP tokens as AMQP headers
# (x-mro-business-token, x-mro-rag-token), read with MCP_DELEGATION_TRANSPORT=amqp_headers.
AI_MODE=disabled
RABBITMQ_URL=
MCP_DELEGATION_TRANSPORT=amqp_headers
# Both files must survive restarts. Existing journals may be retained at their old path.
STATE_DIR=.state
RUN_JOURNAL_PATH=.state/run-journal.sqlite
# Blank uses local SQLite. Postgres requires a separately provisioned AI-only langgraph schema.
CHECKPOINT_DATABASE_URL=
RUN_TIMEOUT_SECONDS=280
MCP_DELEGATION_URL=
MCP_DELEGATION_KEY=
# Docker uses the shared Backend network and overrides host localhost URLs.
BACKEND_NETWORK=backend_default
AI_CONTAINER_RABBITMQ_URL=
